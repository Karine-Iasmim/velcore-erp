@model Velcore.ERP.Web.ViewModels.Acesso.LoginViewModel

@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/login/login.css" />

<div class="login-card card shadow-sm border-0 rounded-4">
    <div class="card-body p-4 p-md-5">
        <div class="login-header text-center mb-4">
            <h2 class="fw-bold mb-1">Velcore ERP</h2>
            <p class="text-muted mb-0">Acesse sua conta para continuar</p>
        </div>

        <form asp-controller="Autenticacao" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="seuemail@empresa.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Senha" class="form-label fw-semibold"></label>
                <input asp-for="Senha" class="form-control form-control-lg" placeholder="Digite sua senha" />
                <span asp-validation-for="Senha" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-dark w-100 btn-lg">Entrar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}