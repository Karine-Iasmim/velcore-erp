<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Velcore ERP</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/layout.css" asp-append-version="true" />
</head>
<body>
    <div class="erp-wrapper d-flex">
        <aside class="erp-sidebar p-3 d-flex flex-column">
            <div class="mb-4">
                <a href="/Home/Index" class="erp-brand text-decoration-none">Velcore ERP</a>
                <div class="erp-subtitle">Painel administrativo</div>
            </div>

            <nav class="nav flex-column erp-nav">
                <a class="nav-link" href="/Home/Index">Início</a>
                <a class="nav-link" href="#">Empresas</a>
                <a class="nav-link" href="#">Clientes</a>
                <a class="nav-link" href="#">Categorias</a>
                <a class="nav-link" href="#">Produtos</a>
            </nav>
        </aside>

        <div class="erp-main flex-grow-1 d-flex flex-column">
            <header class="erp-topbar px-4 py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@ViewData["Title"]</h5>

               @*  @if (User.Identity is { IsAuthenticated: true })
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end">
                            <div class="fw-semibold">@User.Identity.Name</div>
                        </div>

                        <form asp-controller="Autenticacao" asp-action="Logout" method="post" class="mb-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-dark btn-sm">Sair</button>
                        </form>
                    </div>
                } *@
            </header>

            <main class="erp-content p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>